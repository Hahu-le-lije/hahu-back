# Docker environment example for CMS
# Copy this to .env and update values for your environment

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# Database
DB_CONNECTION=pgsql
DB_HOST=cms-db
DB_PORT=5432
DB_DATABASE=cms_db
DB_USERNAME=cms_user
DB_PASSWORD=cms_password

# Authentication & Service Tokens
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_JWKS_VERIFY=true
CLERK_SECRET_KEY=
INTERNAL_SERVICE_TOKEN=your_internal_service_token_here
CMS_SERVICE_SECRET=cms_secret_key

# Service URLs (Docker container names)
CHILD_SERVICE_URL=http://child-service:8001
SYNC_SERVICE_URL=http://sync-service:8002
PARENT_SERVICE_URL=http://localhost:8000

# Service-specific Tokens
CHILD_SERVICE_TOKEN=${INTERNAL_SERVICE_TOKEN}
SYNC_SERVICE_TOKEN=${INTERNAL_SERVICE_TOKEN}

# Laravel
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Logging
LOG_CHANNEL=single
LOG_LEVEL=debug

# Laravel Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:3000
SANCTUM_ENCRYPT_COOKIES=false

# Docker Configuration
LARAVEL_OPTIMIZE=true
RUN_MIGRATIONS=true
